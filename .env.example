# Copy to .env and fill in. .env is gitignored — never commit real keys.
DAYTONA_API_KEY=

# AI provider — set ONE of these paths:
# Mesh API (OpenAI-compatible gateway, https://meshapi.ai). Key format rsk_...
# When MESH_API_KEY is set, the pipeline uses Mesh; model ids take a provider
# prefix (anthropic/..., openai/...).
MESH_API_KEY=
MESH_MODEL=anthropic/claude-opus-5
# MESH_BASE_URL=https://api.meshapi.ai/v1

# Or: direct Anthropic API (used when MESH_API_KEY is unset)
ANTHROPIC_API_KEY=
